# Copy to .env for local Vite/Electron builds.
# Auth, AI proxy, and catalog sync all target the live Bidvera project:

VITE_EXTERNAL_SUPABASE_URL=https://einpdmanlpadqyqnvccb.supabase.co
VITE_EXTERNAL_SUPABASE_ANON_KEY=

# Optional. If set, must be the same project (einpdmanlpadqyqnvccb).
# Do NOT point these at a different Lovable project — catalog sync and AI
# will break. The app code falls back to einpdmanlpadqyqnvccb when unset
# or when VITE_SUPABASE_URL hosts a different ref.
# VITE_SUPABASE_URL=https://einpdmanlpadqyqnvccb.supabase.co
# VITE_SUPABASE_PROJECT_ID=einpdmanlpadqyqnvccb
# VITE_SUPABASE_PUBLISHABLE_KEY=
